# Copy to .env (gitignored) or export these in your shell.

# Postgres connection. When set, the app uses Postgres instead of SQLite.
# Left unset, the app falls back to a local SQLite file at DB_PATH.
DATABASE_URL=postgresql://pipeline_lab:pipeline_lab@localhost:5432/pipeline_lab

# SQLite fallback path (only used when DATABASE_URL is unset).
DB_PATH=todos.db
